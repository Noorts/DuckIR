# name: test/sql/join_search/index_join_filtered.test_slow
# description: A LATERAL join whose KNN subquery filters a table of more than 1,048,576 rows with an IN subquery: release builds compress the join key only from that size. The rows of each query equal those of the filtered single-query index search with that query vector as a constant (via getvariable).
# group: [join_search]

require parquet

require pdxearch

# Row groups of 8192 rows.
statement ok
ATTACH '__TEST_DIR__/index_join_filtered_slow.db' AS index_join_filtered_slow (ROW_GROUP_SIZE 8192);

statement ok
USE index_join_filtered_slow;

statement ok
SET checkpoint_threshold = '10GB';

# Variables
test-env DIMS 128

statement ok
CREATE TABLE t AS SELECT id, emb::FLOAT[${DIMS}] AS emb FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id < 32768;

# The query rows: 10 SIFT vectors that are not in t.
statement ok
CREATE TABLE q AS SELECT (id - 240000)::INTEGER AS qid, emb::FLOAT[${DIMS}] AS vec FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id >= 240000 AND id < 240010;

# ============================================
# A compressed join key in release builds too: DuckDB compresses the key of a subquery of at least 1,048,576 rows.
# t_big has more rows than big_ids, so the hash table is built on big_ids; only t's rows have an embedding.
# ============================================

statement ok
CREATE TABLE t_big AS SELECT range::BIGINT AS id, t.emb FROM range(1200000) LEFT JOIN t ON t.id = range;

statement ok
CREATE TABLE big_ids AS SELECT (range + 16384)::BIGINT AS id FROM range(1100000);

statement ok
CREATE INDEX t_big_idx ON t_big USING PDXEARCH (emb) WITH (metric = 'l2sq', quantization = 'f32', n_probe = 0, seed = 0);

# The index join reads the compressed key through its decompression.
query II
EXPLAIN SELECT q.qid, s.id FROM q, LATERAL (SELECT t_big.id FROM t_big WHERE t_big.id IN (SELECT id FROM big_ids) ORDER BY array_distance(t_big.emb, q.vec) LIMIT 10) s;
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_JOIN.*__internal_decompress.*SEMI.*

statement ok
CREATE OR REPLACE TABLE join_result AS SELECT q.qid, s.id FROM q, LATERAL (SELECT t_big.id FROM t_big WHERE t_big.id IN (SELECT id FROM big_ids) ORDER BY array_distance(t_big.emb, q.vec) LIMIT 10) s;

statement ok
CREATE OR REPLACE TABLE single_result AS FROM join_result LIMIT 0;

loop i 0 10

statement ok
SET VARIABLE query_vector = (SELECT vec FROM q WHERE qid = ${i});

statement ok
INSERT INTO single_result SELECT ${i}, id FROM t_big WHERE id IN (SELECT id FROM big_ids) ORDER BY array_distance(emb, getvariable('query_vector')) LIMIT 10;

endloop

query I
SELECT count(*) FROM join_result;
----
100

query I
SELECT count(*) FROM ((FROM single_result EXCEPT ALL FROM join_result) UNION ALL (FROM join_result EXCEPT ALL FROM single_result));
----
0
