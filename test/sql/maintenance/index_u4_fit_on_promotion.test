# name: test/sql/maintenance/index_u4_fit_on_promotion.test
# description: A u4 index created on an empty table fits SAQ when its row group is promoted to IVF, persists the fit's rotation and model (also over a checkpoint taken before the fit), and builds later row groups on them after a restart.
# group: [maintenance]

require parquet

require duckir

load {TEST_DIR}/index_u4_fit_on_promotion_main.db

statement ok
ATTACH '{TEST_DIR}/index_u4_fit_on_promotion.db' AS p (ROW_GROUP_SIZE 8192);

statement ok
SET checkpoint_threshold = '10GB';

statement ok
SET duckir_vss_n_probe = 0;

# Variables
test-env DIMS 128

test-env LIMIT 10

test-env QUERY_EMB [0,16,35,5,32,31,14,10,11,78,55,10,45,83,11,6,14,57,102,75,20,8,3,5,67,17,19,26,5,0,1,22,60,26,7,1,18,22,84,53,85,119,119,4,24,18,7,7,1,81,106,102,72,30,6,0,9,1,9,119,72,1,4,33,119,29,6,1,0,1,14,52,119,30,3,0,0,55,92,111,2,5,4,9,22,89,96,14,1,0,1,82,59,16,20,5,25,14,11,4,0,0,1,26,47,23,4,0,0,4,38,83,30,14,9,4,9,17,23,41,0,0,2,8,19,25,23,1]

statement ok
CREATE TABLE p.t (id INTEGER, emb FLOAT[{DIMS}]);

statement ok
CREATE INDEX t_idx ON p.t USING DUCKIR_VSS (emb) WITH (metric = 'l2sq', quantization = 'u4', seed = 5);

# Below 2048 rows the row group is Flat, not fitted yet: the search is exact.
statement ok
INSERT INTO p.t SELECT id, emb::FLOAT[{DIMS}] FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id < 1000;

query I
SELECT count(*) FROM (SELECT id FROM p.t ORDER BY array_distance(emb, {QUERY_EMB}::FLOAT[{DIMS}]) LIMIT {LIMIT}) JOIN (SELECT id FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id < 1000 ORDER BY array_distance(emb::FLOAT[{DIMS}], {QUERY_EMB}::FLOAT[{DIMS}]) LIMIT {LIMIT}) USING (id);
----
10

# Persists the index before its fit, with the identity rotation that the fit replaces.
statement ok
CHECKPOINT p;

# Past 2048 rows the row group is promoted to IVF, which fits SAQ.
statement ok
INSERT INTO p.t SELECT id, emb::FLOAT[{DIMS}] FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id >= 1000 AND id < 4000;

query I
SELECT count(*) >= 6 FROM (SELECT id FROM p.t ORDER BY array_distance(emb, {QUERY_EMB}::FLOAT[{DIMS}]) LIMIT {LIMIT}) JOIN (SELECT id FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id < 4000 ORDER BY array_distance(emb::FLOAT[{DIMS}], {QUERY_EMB}::FLOAT[{DIMS}]) LIMIT {LIMIT}) USING (id);
----
true

statement ok
CREATE TABLE p.before_restart AS SELECT id FROM p.t ORDER BY array_distance(emb, {QUERY_EMB}::FLOAT[{DIMS}]) LIMIT {LIMIT};

statement ok
CHECKPOINT p;

restart

statement ok
ATTACH '{TEST_DIR}/index_u4_fit_on_promotion.db' AS p (ROW_GROUP_SIZE 8192);

statement ok
SET checkpoint_threshold = '10GB';

statement ok
SET duckir_vss_n_probe = 0;

# The index reloads with its fit and answers as before the restart.
query I
SELECT quantization FROM duckir_vss_index_info() WHERE index_name = 't_idx';
----
u4

query I
SELECT count(*) FROM (SELECT id FROM p.t ORDER BY array_distance(emb, {QUERY_EMB}::FLOAT[{DIMS}]) LIMIT {LIMIT}) JOIN p.before_restart USING (id);
----
10

# A new row group is built on the persisted fit.
statement ok
INSERT INTO p.t SELECT id, emb::FLOAT[{DIMS}] FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id >= 4000 AND id < 16384;

query I
SELECT count(*) >= 6 FROM (SELECT id FROM p.t ORDER BY array_distance(emb, {QUERY_EMB}::FLOAT[{DIMS}]) LIMIT {LIMIT}) JOIN (SELECT id FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id < 16384 ORDER BY array_distance(emb::FLOAT[{DIMS}], {QUERY_EMB}::FLOAT[{DIMS}]) LIMIT {LIMIT}) USING (id);
----
true
