# name: test/sql/maintenance/index_row_group_merge.test
# description: A checkpoint merges adjacent partial row groups (no deleted rows, sum within the row group size) and drops trailing row groups whose rows are all deleted, even under an index: row ids stay, row-group membership changes. The next search rebuilds the mirrors of the merged row groups from the table and drops the ones of vanished row groups.
# group: [maintenance]

require parquet

require pdxearch

# A database with small row groups keeps the multi-row-group layouts cheap; no automatic checkpoint may merge
# row groups halfway through the test.
statement ok
ATTACH '__TEST_DIR__/merge.db' AS merge (ROW_GROUP_SIZE 8192);

statement ok
USE merge;

statement ok
SET checkpoint_threshold = '10GB';

# Variables
test-env DIMS 128

test-env LIMIT 10

test-env QUERY_EMB [0,16,35,5,32,31,14,10,11,78,55,10,45,83,11,6,14,57,102,75,20,8,3,5,67,17,19,26,5,0,1,22,60,26,7,1,18,22,84,53,85,119,119,4,24,18,7,7,1,81,106,102,72,30,6,0,9,1,9,119,72,1,4,33,119,29,6,1,0,1,14,52,119,30,3,0,0,55,92,111,2,5,4,9,22,89,96,14,1,0,1,82,59,16,20,5,25,14,11,4,0,0,1,26,47,23,4,0,0,4,38,83,30,14,9,4,9,17,23,41,0,0,2,8,19,25,23,1]

test-env ROW_4113 [15,1,1,24,44,9,8,21,48,12,5,49,67,1,0,23,5,8,45,123,112,6,6,2,76,26,50,7,0,0,3,33,22,0,0,14,21,35,48,75,123,34,4,41,23,6,13,43,24,16,95,123,56,8,18,2,20,46,89,21,1,20,9,6,72,9,0,6,27,14,20,93,123,30,1,3,10,62,105,55,9,1,20,40,8,116,123,6,1,3,9,12,2,108,123,7,46,6,2,2,14,3,10,53,39,1,0,0,54,62,28,55,4,0,0,0,38,60,56,8,2,0,0,1,9,15,31,27]

test-env MARKER_A [200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200]

statement ok
CREATE TABLE sift AS SELECT id, emb::FLOAT[${DIMS}] AS emb FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id < 49152;

foreach quantization f32

# Two half-full row groups followed by full ones, all mirrored at CREATE INDEX.
statement ok
CREATE OR REPLACE TABLE t1 AS SELECT * FROM sift WHERE id < 4096;

statement ok
INSERT INTO t1 SELECT * FROM sift WHERE id >= 4096 AND id < 32768;

query II
SELECT row_group_id, sum(count) FROM pragma_storage_info('t1') WHERE column_name = 'id' AND segment_type <> 'VALIDITY' GROUP BY 1 ORDER BY 1;
----
0	4096
1	4096
2	8192
3	8192
4	8192

statement ok
CREATE INDEX t1_idx ON t1 USING PDXEARCH (emb) WITH (metric = 'l2sq', quantization = '${quantization}', n_probe = 0, seed = 0);

query II
EXPLAIN SELECT * FROM t1 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT ${LIMIT};
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_SCAN.*Total Clusters: 600[^0-9].*Row Groups: 5[^0-9].*

# Rows committed but not yet indexed when the checkpoint runs land in a new row group of their own.
statement ok
INSERT INTO t1 VALUES (-1, ${MARKER_A}::FLOAT[${DIMS}]);

statement ok
CHECKPOINT;

query II
SELECT row_group_id, sum(count) FROM pragma_storage_info('t1') WHERE column_name = 'id' AND segment_type <> 'VALIDITY' GROUP BY 1 ORDER BY 1;
----
0	8192
1	8192
2	8192
3	8192
4	1

# The first search rebuilds the merged row group's mirror from the table and indexes the staged row.
query I
SELECT id FROM t1 ORDER BY array_distance(emb, ${MARKER_A}::FLOAT[${DIMS}]) LIMIT 1;
----
-1

query II
EXPLAIN SELECT * FROM t1 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT ${LIMIT};
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_SCAN.*Total Clusters: 481[^0-9].*Row Groups: 5[^0-9].*

# A row from the second half of the merged row group is still found exactly.
query I
SELECT id FROM t1 ORDER BY array_distance(emb, ${ROW_4113}::FLOAT[${DIMS}]) LIMIT 1;
----
4113

statement ok
CREATE OR REPLACE TABLE t_copy AS FROM t1;

statement ok
CREATE OR REPLACE TABLE t_gt AS SELECT id FROM t_copy ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT ${LIMIT};

statement ok
CREATE OR REPLACE TABLE t_idx_res AS SELECT id FROM t1 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT ${LIMIT};

query I
SELECT COUNT(*) >= ${LIMIT} - 1 FROM t_gt JOIN t_idx_res USING (id);
----
true

# Filtered search restricted to the merged row group.
statement ok
CREATE OR REPLACE TABLE t_gt AS SELECT id FROM t_copy WHERE id < 8192 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT ${LIMIT};

statement ok
CREATE OR REPLACE TABLE t_idx_res AS SELECT id FROM t1 WHERE id < 8192 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT ${LIMIT};

query I
SELECT COUNT(*) >= ${LIMIT} - 1 FROM t_gt JOIN t_idx_res USING (id);
----
true

# Maintenance keeps working on the rebuilt mirror.
statement ok
DELETE FROM t1 WHERE id = 4113;

query I
SELECT id <> 4113 FROM t1 ORDER BY array_distance(emb, ${ROW_4113}::FLOAT[${DIMS}]) LIMIT 1;
----
true

statement ok
DELETE FROM t1 WHERE id = -1;

query I
SELECT id <> -1 FROM t1 ORDER BY array_distance(emb, ${MARKER_A}::FLOAT[${DIMS}]) LIMIT 1;
----
true

# A mirror built before a bulk insert stays valid when its row group absorbs the bulk's first rows at a checkpoint:
# the staged rows are appended to it, the rest gets new mirrors.
statement ok
CREATE OR REPLACE TABLE t2 AS SELECT * FROM sift WHERE id < 4096;

statement ok
CREATE INDEX t2_idx ON t2 USING PDXEARCH (emb) WITH (metric = 'l2sq', quantization = '${quantization}', n_probe = 0, seed = 0);

statement ok
INSERT INTO t2 SELECT * FROM sift WHERE id >= 4096 AND id < 16384;

statement ok
CHECKPOINT;

query II
SELECT row_group_id, sum(count) FROM pragma_storage_info('t2') WHERE column_name = 'id' AND segment_type <> 'VALIDITY' GROUP BY 1 ORDER BY 1;
----
0	8192
1	8192

query I
SELECT id FROM t2 ORDER BY array_distance(emb, ${ROW_4113}::FLOAT[${DIMS}]) LIMIT 1;
----
4113

query II
EXPLAIN SELECT * FROM t2 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT ${LIMIT};
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_SCAN.*Row Groups: 2[^0-9].*

statement ok
CREATE OR REPLACE TABLE t_copy AS FROM t2;

statement ok
CREATE OR REPLACE TABLE t_gt AS SELECT id FROM t_copy ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT ${LIMIT};

statement ok
CREATE OR REPLACE TABLE t_idx_res AS SELECT id FROM t2 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT ${LIMIT};

query I
SELECT COUNT(*) >= ${LIMIT} - 1 FROM t_gt JOIN t_idx_res USING (id);
----
true

# A trailing row group whose rows are all deleted is dropped by the checkpoint; its mirror goes with it.
statement ok
CREATE OR REPLACE TABLE t3 AS SELECT * FROM sift WHERE id < 8192 UNION ALL SELECT -1, ${MARKER_A}::FLOAT[${DIMS}];

statement ok
CREATE INDEX t3_idx ON t3 USING PDXEARCH (emb) WITH (metric = 'l2sq', quantization = '${quantization}', n_probe = 0, seed = 0);

query II
EXPLAIN SELECT * FROM t3 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT ${LIMIT};
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_SCAN.*Row Groups: 2[^0-9].*

statement ok
DELETE FROM t3 WHERE id = -1;

statement ok
CHECKPOINT;

query II
SELECT row_group_id, sum(count) FROM pragma_storage_info('t3') WHERE column_name = 'id' AND segment_type <> 'VALIDITY' GROUP BY 1 ORDER BY 1;
----
0	8192

query I
SELECT id <> -1 FROM t3 ORDER BY array_distance(emb, ${MARKER_A}::FLOAT[${DIMS}]) LIMIT 1;
----
true

query II
EXPLAIN SELECT * FROM t3 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT ${LIMIT};
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_SCAN.*Row Groups: 1[^0-9].*

# A row group whose embeddings are all NULL (no mirror) merged with a mirrored partial one: the mirror no longer
# starts with its row group and is rebuilt. Observable through a filter whose DuckDB chunk starts in the NULL rows.
statement ok
CREATE OR REPLACE TABLE t4 AS SELECT id, NULL::FLOAT[${DIMS}] AS emb FROM range(2000) r(id);

statement ok
INSERT INTO t4 SELECT * FROM sift WHERE id >= 5000 AND id < 32768;

query II
SELECT row_group_id, sum(count) FROM pragma_storage_info('t4') WHERE column_name = 'id' AND segment_type <> 'VALIDITY' GROUP BY 1 ORDER BY 1;
----
0	2000
1	3192
2	8192
3	8192
4	8192

statement ok
CREATE INDEX t4_idx ON t4 USING PDXEARCH (emb) WITH (metric = 'l2sq', quantization = '${quantization}', n_probe = 0, seed = 0);

query II
EXPLAIN SELECT * FROM t4 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT ${LIMIT};
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_SCAN.*Total Clusters: 480[^0-9].*Row Groups: 4[^0-9].*

statement ok
CHECKPOINT;

query II
SELECT row_group_id, sum(count) FROM pragma_storage_info('t4') WHERE column_name = 'id' AND segment_type <> 'VALIDITY' GROUP BY 1 ORDER BY 1;
----
0	5192
1	8192
2	8192
3	8192

query I
SELECT COUNT(*) FROM (SELECT id FROM t4 WHERE id < 5048 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 5) WHERE id >= 5000 AND id < 5048;
----
5

query II
EXPLAIN SELECT * FROM t4 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT ${LIMIT};
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_SCAN.*Total Clusters: 480[^0-9].*Row Groups: 4[^0-9].*

statement ok
CREATE OR REPLACE TABLE t_copy AS FROM t4;

statement ok
CREATE OR REPLACE TABLE t_gt AS SELECT id FROM t_copy ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT ${LIMIT};

statement ok
CREATE OR REPLACE TABLE t_idx_res AS SELECT id FROM t4 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT ${LIMIT};

query I
SELECT COUNT(*) >= ${LIMIT} - 1 FROM t_gt JOIN t_idx_res USING (id);
----
true

# Partial row groups merged into a target that DuckDB cuts at new boundaries (5000/5000/8192/5000 -> 8192/8192/6808):
# mirrors straddle the new row groups, so all of them are rebuilt.
statement ok
CREATE OR REPLACE TABLE t5 AS SELECT * FROM sift WHERE id < 5000;

statement ok
INSERT INTO t5 SELECT * FROM sift WHERE id >= 11384 AND id < 29576;

statement ok
INSERT INTO t5 SELECT * FROM sift WHERE id >= 32768 AND id < 49152;

query II
SELECT row_group_id, sum(count) FROM pragma_storage_info('t5') WHERE column_name = 'id' AND segment_type <> 'VALIDITY' GROUP BY 1 ORDER BY 1;
----
0	5000
1	5000
2	8192
3	5000
4	8192
5	8192

statement ok
CREATE INDEX t5_idx ON t5 USING PDXEARCH (emb) WITH (metric = 'l2sq', quantization = '${quantization}', n_probe = 0, seed = 0);

query II
EXPLAIN SELECT * FROM t5 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT ${LIMIT};
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_SCAN.*Total Clusters: 720[^0-9].*Row Groups: 6[^0-9].*

statement ok
CHECKPOINT;

query II
SELECT row_group_id, sum(count) FROM pragma_storage_info('t5') WHERE column_name = 'id' AND segment_type <> 'VALIDITY' GROUP BY 1 ORDER BY 1;
----
0	8192
1	8192
2	6808
3	8192
4	8192

statement ok
CREATE OR REPLACE TABLE t_copy AS FROM t5;

statement ok
CREATE OR REPLACE TABLE t_gt AS SELECT id FROM t_copy ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT ${LIMIT};

statement ok
CREATE OR REPLACE TABLE t_idx_res AS SELECT id FROM t5 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT ${LIMIT};

query I
SELECT COUNT(*) >= ${LIMIT} - 1 FROM t_gt JOIN t_idx_res USING (id);
----
true

query II
EXPLAIN SELECT * FROM t5 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT ${LIMIT};
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_SCAN.*Total Clusters: 600[^0-9].*Row Groups: 5[^0-9].*

# Filtered search over the rows of the merged region.
statement ok
CREATE OR REPLACE TABLE t_copy AS FROM t5;

statement ok
CREATE OR REPLACE TABLE t_gt AS SELECT id FROM t_copy WHERE id >= 11384 AND id < 29576 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT ${LIMIT};

statement ok
CREATE OR REPLACE TABLE t_idx_res AS SELECT id FROM t5 WHERE id >= 11384 AND id < 29576 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT ${LIMIT};

query I
SELECT COUNT(*) >= ${LIMIT} - 1 FROM t_gt JOIN t_idx_res USING (id);
----
true

statement ok
DROP INDEX t1_idx;

statement ok
DROP INDEX t2_idx;

statement ok
DROP INDEX t3_idx;

statement ok
DROP INDEX t4_idx;

statement ok
DROP INDEX t5_idx;

endloop
