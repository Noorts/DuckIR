# name: test/sql/maintenance/index_concurrent_maintenance.test
# description: Connections inserting, searching and deleting at the same time: every search triggers a sync under the exclusive lock while other searches hold the shared one, and nothing is lost or duplicated; a rebuild during a DELETE commit leaves out the rows it deleted; searches never deadlock with checkpoints.
# group: [maintenance]

require parquet

require duckir

# A database with small row groups keeps the multi-row-group layouts cheap; no automatic checkpoint may merge
# row groups halfway through the test.
statement ok
ATTACH '{TEST_DIR}/conc.db' AS conc (ROW_GROUP_SIZE 8192);

statement ok
USE conc;

statement ok
SET checkpoint_threshold = '10GB';

# Variables
test-env DIMS 128

test-env LIMIT 10

test-env QUERY_EMB [0,16,35,5,32,31,14,10,11,78,55,10,45,83,11,6,14,57,102,75,20,8,3,5,67,17,19,26,5,0,1,22,60,26,7,1,18,22,84,53,85,119,119,4,24,18,7,7,1,81,106,102,72,30,6,0,9,1,9,119,72,1,4,33,119,29,6,1,0,1,14,52,119,30,3,0,0,55,92,111,2,5,4,9,22,89,96,14,1,0,1,82,59,16,20,5,25,14,11,4,0,0,1,26,47,23,4,0,0,4,38,83,30,14,9,4,9,17,23,41,0,0,2,8,19,25,23,1]

statement ok
CREATE TABLE sift AS SELECT id, emb::FLOAT[{DIMS}] AS emb FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id < 32768;

foreach quantization f32

statement ok
CREATE OR REPLACE TABLE t1 AS SELECT * FROM sift WHERE id < 8192;

statement ok
CREATE INDEX t1_idx ON t1 USING DUCKIR_VSS (emb) WITH (metric = 'l2sq', quantization = '{quantization}', n_probe = 0, seed = 0);

# Eight connections, each committing 100 rows, searching, deleting one of its rows, and searching again.
concurrentloop threadid 0 8

statement ok
USE conc;

statement ok
INSERT INTO t1 SELECT * FROM sift WHERE id >= 8192 + 100 * {threadid} AND id < 8192 + 100 * ({threadid} + 1);

query I
SELECT COUNT(*) FROM (SELECT id FROM t1 ORDER BY array_distance(emb, {QUERY_EMB}::FLOAT[{DIMS}]) LIMIT 5);
----
5

statement ok
DELETE FROM t1 WHERE id = 8192 + 100 * {threadid};

query I
SELECT COUNT(*) FROM (SELECT id FROM t1 ORDER BY array_distance(emb, {QUERY_EMB}::FLOAT[{DIMS}]) LIMIT 5);
----
5

endloop

query I
SELECT COUNT(*) FROM t1;
----
8984

# Everything committed is indexed exactly once.
query II
CALL duckir_vss_sync_index('t1_idx');
----
t1_idx	false

statement ok
CREATE OR REPLACE TABLE t_copy AS FROM t1;

statement ok
CREATE OR REPLACE TABLE t_gt AS SELECT id FROM t_copy ORDER BY array_distance(emb, {QUERY_EMB}::FLOAT[{DIMS}]) LIMIT {LIMIT};

statement ok
CREATE OR REPLACE TABLE t_idx_res AS SELECT id FROM t1 ORDER BY array_distance(emb, {QUERY_EMB}::FLOAT[{DIMS}]) LIMIT {LIMIT};

query I
SELECT COUNT(*) >= {LIMIT} - 1 FROM t_gt JOIN t_idx_res USING (id);
----
true

query II
SELECT COUNT(*), COUNT(DISTINCT id) FROM (SELECT id FROM t1 WHERE id >= 8192 ORDER BY array_distance(emb, {QUERY_EMB}::FLOAT[{DIMS}]) LIMIT 50);
----
50	50

statement ok
DROP INDEX t1_idx;

endloop

# One query with two searches on the same index, and an INSERT committed by another connection between them: the
# second search shares the first one's lock instead of queueing behind the INSERT's (a deadlock).
statement ok
CREATE TABLE t2 AS FROM sift;

statement ok
CREATE INDEX t2_idx ON t2 USING DUCKIR_VSS (emb) WITH (quantization = 'f32', n_probe = 0, seed = 0);

concurrentloop threadid 0 2

statement ok
USE conc;

# Keeps the written order: the LATERAL search (the hash join's build side) runs before the other one starts.
onlyif threadid=0
statement ok
SET disabled_optimizers = 'join_order,build_side_probe_side';

onlyif threadid=0
query I
SELECT count(*) >= 0 FROM (SELECT id FROM t2 ORDER BY array_distance(emb, {QUERY_EMB}::FLOAT[{DIMS}]) LIMIT {LIMIT}) b
JOIN (SELECT n.id FROM (SELECT emb FROM sift WHERE id < 16384) q,
LATERAL (SELECT t2.id FROM t2 ORDER BY array_distance(t2.emb, q.emb) LIMIT {LIMIT}) n) a ON a.id = b.id;
----
true

onlyif threadid=1
statement ok
SELECT count(*) FROM range(50000000) r WHERE r.range % 7 = 3;

onlyif threadid=1
statement ok
INSERT INTO t2 SELECT id + 100000, emb FROM sift WHERE id < 10;

endloop

# A filtered search holds the search lock while another connection commits an INSERT: the commit never waits for it.
concurrentloop threadid 0 2

statement ok
USE conc;

# The scan of t2 below the semi join starts only after the slow build side.
onlyif threadid=0
statement ok
SET disabled_optimizers = 'build_side_probe_side';

onlyif threadid=0
query I
SELECT count(*) FROM (SELECT id FROM t2 WHERE id IN (SELECT (r.range % 32768)::INTEGER FROM range(400000000) r WHERE r.range % 1000 = 7)
ORDER BY array_distance(emb, {QUERY_EMB}::FLOAT[{DIMS}]) LIMIT {LIMIT});
----
10

onlyif threadid=1
statement ok
SELECT count(*) FROM range(50000000) r WHERE r.range % 7 = 3;

onlyif threadid=1
statement ok
INSERT INTO t2 SELECT id + 200000, emb FROM sift WHERE id < 10;

endloop

# DROP INDEX on another connection while a query that planned with the index waits for a slow pipeline: the query
# fails cleanly, or DROP INDEX waits for it to end. It never searches a dropped index.
concurrentloop threadid 0 2

statement ok
USE conc;

onlyif threadid=0
statement ok
SET disabled_optimizers = 'join_order,build_side_probe_side';

onlyif threadid=0
statement maybe
SELECT count(*) FROM (SELECT id FROM t2 ORDER BY array_distance(emb, {QUERY_EMB}::FLOAT[{DIMS}]) LIMIT {LIMIT}) s,
(SELECT count(*) AS c FROM range(200000000) r WHERE r.range % 7 = 3) slow;
----
dropped by a concurrent transaction

onlyif threadid=1
statement ok
SELECT count(*) FROM range(50000000) r WHERE r.range % 7 = 3;

onlyif threadid=1
statement ok
DROP INDEX t2_idx;

endloop

# A search rebuilds a mirror a checkpoint re-cut while another connection commits a large DELETE: the rebuild reads
# the table as of the last published commit, so it must leave out the rows the DELETE already removed from the index.
statement ok
SET threads = 8;

statement ok
CREATE TABLE t3 AS SELECT id, emb::FLOAT[{DIMS}] AS emb FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id < 5000;

statement ok
INSERT INTO t3 SELECT id, emb::FLOAT[{DIMS}] FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id >= 5000 AND id < 23192;

statement ok
INSERT INTO t3 SELECT id, emb::FLOAT[{DIMS}] FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id >= 23192 AND id < 244376;

statement ok
CREATE INDEX t3_idx ON t3 USING DUCKIR_VSS (emb) WITH (quantization = 'f32', n_probe = 0, seed = 0);

# The first sync after CREATE INDEX: the DELETE below then reaches the index at commit.
statement ok
CALL duckir_vss_sync_index('t3_idx');

statement ok
CREATE TABLE t3_dels AS SELECT * FROM t3 WHERE rowid < 23192 AND id % 10 = 0;

# The checkpoint re-cuts the first row groups (5000 / 8192 / 8192 / 1808 -> 8192 / 8192 / 6808): their mirrors go
# stale, and no search rebuilds them before the DELETE.
statement ok
CHECKPOINT conc;

query II
SELECT row_group_id, sum(count) FROM pragma_storage_info('t3') WHERE column_name = 'id' AND segment_type <> 'VALIDITY' AND row_group_id < 3 GROUP BY 1 ORDER BY 1;
----
0	8192
1	8192
2	6808

# Connection 1 starts its transaction first (a new one waits for the commit), then searches while the DELETE commits.
concurrentloop threadid 0 2

statement ok
USE conc;

onlyif threadid=1
statement ok
BEGIN;

onlyif threadid=1
statement ok
SELECT id FROM t3_dels LIMIT 1;

onlyif threadid=0
statement ok
BEGIN;

onlyif threadid=0
statement ok
DELETE FROM t3 WHERE id % 2 = 0;

onlyif threadid=0
statement ok
COMMIT;

sleep 40 milliseconds

onlyif threadid=1
statement ok
SELECT id FROM t3 ORDER BY array_distance(emb, {QUERY_EMB}::FLOAT[{DIMS}]) LIMIT 1;

onlyif threadid=1
statement ok
COMMIT;

endloop

statement ok
CALL duckir_vss_sync_index('t3_idx');

# Each deleted row's vector finds a live row: a deleted row still in the index would take the slot.
query I
SELECT (SELECT COUNT(*) FROM t3_dels) - COUNT(*) FROM t3_dels AS q, LATERAL (SELECT r.id FROM t3 AS r ORDER BY array_distance(r.emb, q.emb) LIMIT 1) s;
----
0

# Searches joined back to their table, filtered searches and LATERAL searches never deadlock with checkpoints.
statement ok
RESET disabled_optimizers;

statement ok
CREATE TABLE t4 AS SELECT id, emb::FLOAT[{DIMS}] AS emb FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet');

statement ok
CREATE INDEX t4_idx ON t4 USING DUCKIR_VSS (emb) WITH (quantization = 'u8');

statement ok
CREATE TABLE u (i INTEGER);

statement ok
CHECKPOINT conc;

concurrentloop threadid 0 4

statement ok
USE conc;

loop i 0 60

onlyif threadid=0
statement ok
SELECT t.* FROM (SELECT id FROM t4 ORDER BY array_distance(emb, {QUERY_EMB}::FLOAT[{DIMS}]) LIMIT 10) s JOIN t4 t ON s.id = t.id;

onlyif threadid=1
statement ok
SELECT id FROM t4 WHERE id % 3 = 0 ORDER BY array_distance(emb, {QUERY_EMB}::FLOAT[{DIMS}]) LIMIT 5;

onlyif threadid=2
statement ok
SELECT count(*) FROM (SELECT id, emb FROM t4 WHERE id < 5) q, LATERAL (SELECT t4.id FROM t4 ORDER BY array_distance(t4.emb, q.emb) LIMIT 3);

onlyif threadid=3
statement ok
INSERT INTO u VALUES (${i});

onlyif threadid=3
statement ok
CHECKPOINT conc;

endloop

endloop
