# name: test/sql/maintenance/index_transactions.test
# description: The index only sees committed rows: a rolled-back insert, or a row inserted and deleted in the same transaction, never reaches it; a multi-statement transaction reaches it at COMMIT.
# group: [maintenance]

require parquet

require pdxearch

# A database with small row groups keeps the multi-row-group layouts cheap; no automatic checkpoint may merge
# row groups halfway through the test.
statement ok
ATTACH '__TEST_DIR__/txn.db' AS txn (ROW_GROUP_SIZE 8192);

statement ok
USE txn;

statement ok
SET checkpoint_threshold = '10GB';

# Variables
test-env DIMS 128

test-env LIMIT 10

test-env MARKER_A [200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200,200]

statement ok
CREATE TABLE sift AS SELECT id, emb::FLOAT[${DIMS}] AS emb FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id < 32768;

foreach quantization f32

statement ok
CREATE OR REPLACE TABLE t1 AS SELECT * FROM sift WHERE id < 20000;

statement ok
CREATE INDEX t1_idx ON t1 USING PDXEARCH (emb) WITH (metric = 'l2sq', quantization = '${quantization}', n_probe = 0, seed = 0);

# Rolled back: never reaches the index.
statement ok
BEGIN;

statement ok
INSERT INTO t1 VALUES (-1, ${MARKER_A}::FLOAT[${DIMS}]);

statement ok
ROLLBACK;

query I
SELECT id <> -1 FROM t1 ORDER BY array_distance(emb, ${MARKER_A}::FLOAT[${DIMS}]) LIMIT 1;
----
true

# Inserted and deleted in one transaction: nothing to index.
statement ok
BEGIN;

statement ok
INSERT INTO t1 VALUES (-2, ${MARKER_A}::FLOAT[${DIMS}]);

statement ok
DELETE FROM t1 WHERE id = -2;

statement ok
COMMIT;

query I
SELECT id <> -2 FROM t1 ORDER BY array_distance(emb, ${MARKER_A}::FLOAT[${DIMS}]) LIMIT 1;
----
true

# A multi-statement transaction reaches the index at COMMIT.
statement ok
BEGIN;

statement ok
INSERT INTO t1 VALUES (-3, ${MARKER_A}::FLOAT[${DIMS}]);

statement ok
INSERT INTO t1 SELECT * FROM sift WHERE id >= 20000 AND id < 20100;

statement ok
COMMIT;

query I
SELECT id FROM t1 ORDER BY array_distance(emb, ${MARKER_A}::FLOAT[${DIMS}]) LIMIT 1;
----
-3

query I
SELECT COUNT(*) FROM t1;
----
20101

# Delete the tail, checkpoint, and insert again.
statement ok
DELETE FROM t1 WHERE id >= 20000 OR id = -3;

statement ok
CHECKPOINT;

query I
SELECT id <> -3 FROM t1 ORDER BY array_distance(emb, ${MARKER_A}::FLOAT[${DIMS}]) LIMIT 1;
----
true

statement ok
INSERT INTO t1 VALUES (-4, ${MARKER_A}::FLOAT[${DIMS}]);

query I
SELECT id FROM t1 ORDER BY array_distance(emb, ${MARKER_A}::FLOAT[${DIMS}]) LIMIT 1;
----
-4

statement ok
DROP INDEX t1_idx;

endloop
