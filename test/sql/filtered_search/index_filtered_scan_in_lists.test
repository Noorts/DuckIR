# name: test/sql/filtered_search/index_filtered_scan_in_lists.test
# description: IN lists of at least five constants, which DuckDB turns into a MARK join against the list of constants and a FILTER on the join's marker, feed the filtered index search: the join stays below the search and evaluates the list, and the results equal the brute-force search.
# group: [filtered_search]

require parquet

require pdxearch

# Row groups of 8192 rows (4 in the table), so selective filters glue the rows of several row groups into one chunk.
statement ok
ATTACH '__TEST_DIR__/in_lists.db' AS in_lists (ROW_GROUP_SIZE 8192);

statement ok
USE in_lists;

statement ok
SET checkpoint_threshold = '10GB';

# Variables
test-env DIMS 128

# Row 0's embedding with the first value changed from 0 to 1: no row of the table is at distance 0, so row -1 below is
# the only nearest row and no two results tie.
test-env QUERY_EMB [1,16,35,5,32,31,14,10,11,78,55,10,45,83,11,6,14,57,102,75,20,8,3,5,67,17,19,26,5,0,1,22,60,26,7,1,18,22,84,53,85,119,119,4,24,18,7,7,1,81,106,102,72,30,6,0,9,1,9,119,72,1,4,33,119,29,6,1,0,1,14,52,119,30,3,0,0,55,92,111,2,5,4,9,22,89,96,14,1,0,1,82,59,16,20,5,25,14,11,4,0,0,1,26,47,23,4,0,0,4,38,83,30,14,9,4,9,17,23,41,0,0,2,8,19,25,23,1]

# 40 ids spread over all row groups.
test-env IDS 0,797,1594,2391,3188,3985,4782,5579,6376,7173,7970,8767,9564,10361,11158,11955,12752,13549,14346,15143,15940,16737,17534,18331,19128,19925,20722,21519,22316,23113,23910,24707,25504,26301,27098,27895,28692,29489,30286,31083

test-env NAMES 'n0','n3','n6','n9','n12','n15','n18','n21','n24','n27','n30','n33','n36','n39','n42','n45','n48','n51','n54','n57'

# t is indexed; t_bf is an unindexed copy whose searches give the brute-force result. Row -1 has no name and the query
# vector as its embedding: it is the nearest row whenever it passes a predicate.
statement ok
CREATE TABLE t AS SELECT id, (id % 10)::INTEGER AS cat, 'n' || (id % 100) AS name, emb::FLOAT[${DIMS}] AS emb FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id < 32768;

statement ok
INSERT INTO t VALUES (-1, 3, NULL, ${QUERY_EMB}::FLOAT[${DIMS}]);

statement ok
CREATE TABLE t_bf AS FROM t;

statement ok
CREATE INDEX t_idx ON t USING PDXEARCH (emb) WITH (metric = 'l2sq', quantization = 'f32', n_probe = 0, seed = 0);

statement ok
CREATE VIEW v AS SELECT * FROM t WHERE id % 2 = 0 OR cat = 1;

statement ok
CREATE VIEW v_bf AS SELECT * FROM t_bf WHERE id % 2 = 0 OR cat = 1;

foreach threads 1 4

statement ok
SET threads = ${threads};

# ============================================
# Where DuckDB (v1.5.6) switches to the MARK join: 4 constants are an OR of equalities in a FILTER, 5 a MARK join.
# ============================================

query II
EXPLAIN SELECT id FROM t WHERE id IN (5, 797, 1594, 2391) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----
physical_plan	<!REGEX>:.*HASH_JOIN.*

query I nosort four_constants
SELECT id FROM t WHERE id IN (5, 797, 1594, 2391) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query I nosort four_constants
SELECT id FROM t_bf WHERE id IN (5, 797, 1594, 2391) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query II
EXPLAIN SELECT id FROM t WHERE id IN (5, 797, 1594, 2391, 3188) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_FILT_SCAN.*FILTER.*HASH_JOIN.*SEQ_SCAN.*

query I nosort five_constants
SELECT id FROM t WHERE id IN (5, 797, 1594, 2391, 3188) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query I nosort five_constants
SELECT id FROM t_bf WHERE id IN (5, 797, 1594, 2391, 3188) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

# ============================================
# 40 constants: fewer passing rows than K = 100. The scan below the search does not read the embedding.
# ============================================

query II
EXPLAIN SELECT id FROM t WHERE id IN (${IDS}) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----
physical_plan	<!REGEX>:.*SEQ_SCAN.*emb.*

query I nosort forty_constants_k10
SELECT id FROM t WHERE id IN (${IDS}) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query I nosort forty_constants_k10
SELECT id FROM t_bf WHERE id IN (${IDS}) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query I nosort forty_constants_k100
SELECT id FROM t WHERE id IN (${IDS}) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

query I nosort forty_constants_k100
SELECT id FROM t_bf WHERE id IN (${IDS}) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

query I
SELECT COUNT(*) FROM (SELECT id FROM t WHERE id IN (${IDS}) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100);
----
40

# A NULL and a duplicate in the list.
query I nosort null_and_duplicate
SELECT id FROM t WHERE id IN (${IDS}, NULL, 797) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

query I nosort null_and_duplicate
SELECT id FROM t_bf WHERE id IN (${IDS}, NULL, 797) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

# With a filter DuckDB pushes into the scan on another column.
query I nosort in_and_pushed_filter
SELECT id FROM t WHERE id IN (${IDS}) AND cat = 0 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query I nosort in_and_pushed_filter
SELECT id FROM t_bf WHERE id IN (${IDS}) AND cat = 0 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

# ============================================
# Inside an OR, negated, over an expression, two lists in one predicate.
# ============================================

query I nosort or_with_in
SELECT id FROM t WHERE cat = 3 OR id IN (${IDS}) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

query I nosort or_with_in
SELECT id FROM t_bf WHERE cat = 3 OR id IN (${IDS}) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

query II
EXPLAIN SELECT id FROM t WHERE cat = 3 OR id NOT IN (${IDS}) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_FILT_SCAN.*FILTER.*HASH_JOIN.*SEQ_SCAN.*

query I nosort or_with_not_in
SELECT id FROM t WHERE cat = 3 OR id NOT IN (${IDS}) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query I nosort or_with_not_in
SELECT id FROM t_bf WHERE cat = 3 OR id NOT IN (${IDS}) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query I nosort expression_in
SELECT id FROM t WHERE id % 1000 IN (1, 7, 13, 99, 500, 998) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query I nosort expression_in
SELECT id FROM t_bf WHERE id % 1000 IN (1, 7, 13, 99, 500, 998) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query II
EXPLAIN SELECT id FROM t WHERE id IN (${IDS}) OR name IN (${NAMES}) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_FILT_SCAN.*FILTER.*HASH_JOIN.*HASH_JOIN.*SEQ_SCAN.*

query I nosort two_lists
SELECT id FROM t WHERE id IN (${IDS}) OR name IN (${NAMES}) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query I nosort two_lists
SELECT id FROM t_bf WHERE id IN (${IDS}) OR name IN (${NAMES}) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

# ============================================
# VARCHAR constants. Row -1 has no name: `name IN` never keeps it, `name NOT IN (...) OR cat = 3` keeps it through
# `cat = 3`.
# ============================================

query I nosort varchar_in
SELECT id FROM t WHERE name IN (${NAMES}) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query I nosort varchar_in
SELECT id FROM t_bf WHERE name IN (${NAMES}) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query I
SELECT COUNT(*) FILTER (WHERE id = -1) FROM (SELECT id FROM t WHERE name IN (${NAMES}) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10);
----
0

query I
SELECT id FROM t WHERE name NOT IN (${NAMES}) OR cat = 3 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 1;
----
-1

query I nosort varchar_not_in_or
SELECT id FROM t WHERE name NOT IN (${NAMES}) OR cat = 3 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query I nosort varchar_not_in_or
SELECT id FROM t_bf WHERE name NOT IN (${NAMES}) OR cat = 3 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

# Constants inside the column's value range that no row holds.
query II
EXPLAIN SELECT id FROM t WHERE name IN ('n100', 'n101', 'n102', 'n103', 'n104') ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_FILT_SCAN.*FILTER.*HASH_JOIN.*SEQ_SCAN.*

query I
SELECT COUNT(*) FROM (SELECT id FROM t WHERE name IN ('n100', 'n101', 'n102', 'n103', 'n104') ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10);
----
0

# ============================================
# An IN list on the embedding: the join's condition reads it, so the scan keeps it and emits the rowid as well.
# ============================================

query II
EXPLAIN SELECT id FROM t WHERE emb[1] IN (0, 1, 2, 3, 4, 5) OR cat = 3 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_FILT_SCAN.*FILTER.*HASH_JOIN.*SEQ_SCAN.*emb.*

query I nosort embedding_in
SELECT id FROM t WHERE emb[1] IN (0, 1, 2, 3, 4, 5) OR cat = 3 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query I nosort embedding_in
SELECT id FROM t_bf WHERE emb[1] IN (0, 1, 2, 3, 4, 5) OR cat = 3 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

# ============================================
# Through a view.
# ============================================

query I nosort view_in
SELECT id FROM v WHERE id IN (${IDS}) OR cat = 5 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query I nosort view_in
SELECT id FROM v_bf WHERE id IN (${IDS}) OR cat = 5 ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

# ============================================
# The marker read as a value (IN in the SELECT list) keeps the brute-force plan.
# ============================================

query II
EXPLAIN SELECT id, id IN (${IDS}) AS m FROM t ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----
physical_plan	<!REGEX>:.*PDXEARCH.*

query II nosort marker_selected
SELECT id, id IN (${IDS}) AS m FROM t ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query II nosort marker_selected
SELECT id, id IN (${IDS}) AS m FROM t_bf ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

# ============================================
# An IN list inside an OR, against brute force.
# ============================================

query II
EXPLAIN SELECT id FROM t WHERE cat = 3 OR id IN (${IDS}) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_FILT_SCAN.*

# No late materialization (a second scan of t, joined on the rowid).
query II
EXPLAIN SELECT id FROM t WHERE cat = 3 OR id IN (${IDS}) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----
physical_plan	<!REGEX>:.*rowid = rowid.*

query I nosort or_with_in_k10
SELECT id FROM t WHERE cat = 3 OR id IN (${IDS}) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query I nosort or_with_in_k10
SELECT id FROM t_bf WHERE cat = 3 OR id IN (${IDS}) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

endloop
