# name: test/sql/filtered_search/index_filtered_scan_low_selectivity.test
# description: At low selectivity a filtered search probes more clusters first, which hold fewer passing rows each: the filtered scan and the filtered LATERAL join keep their recall at a 1% filter.
# group: [filtered_search]

require parquet

require duckir

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

# Two row groups of SIFT; r < 100 keeps 1% of the rows.
statement ok
CREATE TABLE t AS SELECT id, emb::FLOAT[128] AS emb, hash(id) % 10000 AS r FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet');

statement ok
CREATE TABLE t_bf AS FROM t;

statement ok
CREATE INDEX t_idx ON t USING DUCKIR_VSS (emb) WITH (metric = 'l2sq', quantization = 'u8', seed = 0);

statement ok
CREATE TABLE qs AS SELECT row_number() OVER (ORDER BY id) AS qid, emb AS q FROM t WHERE hash(id + 7) % 12288 = 0 ORDER BY id LIMIT 20;

statement ok
CREATE TABLE gt AS SELECT qid, (SELECT list(id) FROM (SELECT id FROM t_bf WHERE r < 100 ORDER BY array_distance(emb, q) LIMIT 100)) AS ids FROM qs;

# The filtered scan: one search per query.
statement ok
CREATE TABLE res_scan (qid BIGINT, ids BIGINT[]);

statement ok
SET VARIABLE q = (SELECT q FROM qs WHERE qid = 1);

query II
EXPLAIN SELECT id FROM t WHERE r < 100 ORDER BY array_distance(emb, getvariable('q')) LIMIT 100;
----
physical_plan	<REGEX>:.*DUCKIR_VSS_INDEX_FILT_SCAN.*

loop i 1 21

statement ok
SET VARIABLE q = (SELECT q FROM qs WHERE qid = ${i});

statement ok
INSERT INTO res_scan SELECT ${i}, (SELECT list(id) FROM (SELECT id FROM t WHERE r < 100 ORDER BY array_distance(emb, getvariable('q')) LIMIT 100));

endloop

query I
SELECT avg(len(list_intersect(r.ids, g.ids)) / len(g.ids)) >= 0.9 FROM res_scan r JOIN gt g USING (qid);
----
true

# The filtered LATERAL join: all queries at once.
query II
EXPLAIN SELECT qid, id FROM qs, LATERAL (SELECT id FROM t WHERE r < 100 ORDER BY array_distance(emb, q) LIMIT 100);
----
physical_plan	<REGEX>:.*DUCKIR_VSS_INDEX_JOIN.*

query I
SELECT avg(len(list_intersect(r.ids, g.ids)) / len(g.ids)) >= 0.9 FROM (SELECT qid, list(id) AS ids FROM qs, LATERAL (SELECT id FROM t WHERE r < 100 ORDER BY array_distance(emb, q) LIMIT 100) GROUP BY qid) r JOIN gt g USING (qid);
----
true
