# name: test/sql/filtered_search/index_filtered_scan_subqueries.test
# description: Subqueries used as filters feed the filtered index search when DuckDB plans them as a SEMI, ANTI or MARK join with the indexed table on the probe side: the join stays below the search, keeps its runtime filters on the table scan, and the results equal the brute-force search. Results are compared as sets (rowsort): SIFT has duplicate vectors, so some neighbours tie.
# group: [filtered_search]

require parquet

require pdxearch

# Row groups of 8192 rows (4 in the table).
statement ok
ATTACH '__TEST_DIR__/subqueries.db' AS subqueries (ROW_GROUP_SIZE 8192);

statement ok
USE subqueries;

statement ok
SET checkpoint_threshold = '10GB';

# Variables
test-env DIMS 128

test-env QUERY_EMB [0,16,35,5,32,31,14,10,11,78,55,10,45,83,11,6,14,57,102,75,20,8,3,5,67,17,19,26,5,0,1,22,60,26,7,1,18,22,84,53,85,119,119,4,24,18,7,7,1,81,106,102,72,30,6,0,9,1,9,119,72,1,4,33,119,29,6,1,0,1,14,52,119,30,3,0,0,55,92,111,2,5,4,9,22,89,96,14,1,0,1,82,59,16,20,5,25,14,11,4,0,0,1,26,47,23,4,0,0,4,38,83,30,14,9,4,9,17,23,41,0,0,2,8,19,25,23,1]

# t is indexed; t_bf is an unindexed copy whose searches give the brute-force result.
statement ok
CREATE TABLE t AS SELECT id, (id % 10)::INTEGER AS cat, emb::FLOAT[${DIMS}] AS emb FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id < 32768;

statement ok
CREATE TABLE t_bf AS FROM t;

statement ok
CREATE INDEX t_idx ON t USING PDXEARCH (emb) WITH (metric = 'l2sq', quantization = 'f32', n_probe = 0, seed = 0);

# small is smaller than t, so DuckDB builds the hash table on small and probes with t. big is larger than t, so DuckDB
# builds on t instead (RIGHT_SEMI), which the index scans do not handle yet.
statement ok
CREATE TABLE small AS SELECT (range * 7)::BIGINT AS x, (range % 3)::INTEGER AS g FROM range(2000);

statement ok
CREATE TABLE small_with_null AS SELECT CASE WHEN range = 0 THEN NULL ELSE (range * 7)::BIGINT END AS x FROM range(2000);

statement ok
CREATE TABLE big AS SELECT (range * 3)::BIGINT AS x FROM range(200000);

foreach threads 1 4

statement ok
SET threads = ${threads};

# ============================================
# IN and EXISTS subqueries: a SEMI join below the search. Debug builds compress the key of every SEMI and ANTI join:
# the search reads it through the decompression and still uses the index.
# ============================================

query II
EXPLAIN SELECT id FROM t WHERE id IN (SELECT x FROM small) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_FILT_SCAN.*HASH_JOIN.*SEMI.*SEQ_SCAN.*

query I rowsort in_subquery_k10
SELECT id FROM t WHERE id IN (SELECT x FROM small) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query I rowsort in_subquery_k10
SELECT id FROM t_bf WHERE id IN (SELECT x FROM small) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query I rowsort in_subquery_k100
SELECT id FROM t WHERE id IN (SELECT x FROM small) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

query I rowsort in_subquery_k100
SELECT id FROM t_bf WHERE id IN (SELECT x FROM small) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

# The join's runtime filters (the values of small) stay on the table scan below the search. Debug builds compress the
# key, and DuckDB does not push runtime filters through the compression.
query II
EXPLAIN ANALYZE SELECT id FROM t WHERE id IN (SELECT x FROM small) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----
analyzed_plan	<REGEX>:.*(Dynamic Filters|__internal_decompress).*

query I rowsort in_subquery_with_filter
SELECT id FROM t WHERE id IN (SELECT x FROM small WHERE g = 1) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

query I rowsort in_subquery_with_filter
SELECT id FROM t_bf WHERE id IN (SELECT x FROM small WHERE g = 1) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

query I rowsort exists
SELECT id FROM t WHERE EXISTS (SELECT 1 FROM small s WHERE s.x = t.id) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

query I rowsort exists
SELECT id FROM t_bf WHERE EXISTS (SELECT 1 FROM small s WHERE s.x = t_bf.id) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

query I rowsort cte_as_filter
WITH c AS (SELECT x FROM small WHERE g = 2) SELECT id FROM t WHERE id IN (SELECT x FROM c) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

query I rowsort cte_as_filter
WITH c AS (SELECT x FROM small WHERE g = 2) SELECT id FROM t_bf WHERE id IN (SELECT x FROM c) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

# The subquery scans the indexed table itself.
query I rowsort self_semi_join
SELECT id FROM t WHERE id IN (SELECT id + 1 FROM t WHERE cat = 1) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

query I rowsort self_semi_join
SELECT id FROM t_bf WHERE id IN (SELECT id + 1 FROM t_bf WHERE cat = 1) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

# Two subqueries (two SEMI joins), and a subquery with a residual filter.
query I rowsort two_subqueries
SELECT id FROM t WHERE id IN (SELECT x FROM small) AND cat IN (SELECT g FROM small) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

query I rowsort two_subqueries
SELECT id FROM t_bf WHERE id IN (SELECT x FROM small) AND cat IN (SELECT g FROM small) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

query I rowsort subquery_and_residual_filter
SELECT id FROM t WHERE id IN (SELECT x FROM small) AND (cat = 1 OR id > 30000) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

query I rowsort subquery_and_residual_filter
SELECT id FROM t_bf WHERE id IN (SELECT x FROM small) AND (cat = 1 OR id > 30000) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

# Over a subquery of the table.
query I rowsort in_subquery_over_subquery
SELECT id FROM (SELECT * FROM t WHERE id IN (SELECT x FROM small)) s ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

query I rowsort in_subquery_over_subquery
SELECT id FROM (SELECT * FROM t_bf WHERE id IN (SELECT x FROM small)) s ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

# ============================================
# NOT EXISTS: an ANTI join below the search.
# ============================================

query II
EXPLAIN SELECT id FROM t WHERE NOT EXISTS (SELECT 1 FROM small s WHERE s.x = t.id) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_FILT_SCAN.*HASH_JOIN.*ANTI.*SEQ_SCAN.*

query I rowsort not_exists
SELECT id FROM t WHERE NOT EXISTS (SELECT 1 FROM small s WHERE s.x = t.id) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

query I rowsort not_exists
SELECT id FROM t_bf WHERE NOT EXISTS (SELECT 1 FROM small s WHERE s.x = t_bf.id) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

# ============================================
# NOT IN and IN inside a larger predicate: a MARK join below the search, tested by a FILTER.
# ============================================

query II
EXPLAIN SELECT id FROM t WHERE id NOT IN (SELECT x FROM small) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_FILT_SCAN.*FILTER.*HASH_JOIN.*MARK.*SEQ_SCAN.*

query I rowsort not_in_subquery
SELECT id FROM t WHERE id NOT IN (SELECT x FROM small) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

query I rowsort not_in_subquery
SELECT id FROM t_bf WHERE id NOT IN (SELECT x FROM small) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

# A NULL in the subquery makes NOT IN unknown for every row that is not in it: no row passes.
query I
SELECT COUNT(*) FROM (SELECT id FROM t WHERE id NOT IN (SELECT x FROM small_with_null) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10);
----
0

query I rowsort or_with_in_subquery
SELECT id FROM t WHERE cat = 3 OR id IN (SELECT x FROM small) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

query I rowsort or_with_in_subquery
SELECT id FROM t_bf WHERE cat = 3 OR id IN (SELECT x FROM small) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 100;
----

# ============================================
# Not handled yet: t on the build side (the subquery is larger than t) and correlated subqueries that stay a
# DELIM_JOIN keep the brute-force plan.
# ============================================

query II
EXPLAIN SELECT id FROM t WHERE id IN (SELECT x FROM big) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----
physical_plan	<!REGEX>:.*PDXEARCH.*

query I rowsort build_side
SELECT id FROM t WHERE id IN (SELECT x FROM big) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query I rowsort build_side
SELECT id FROM t_bf WHERE id IN (SELECT x FROM big) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query II
EXPLAIN SELECT id FROM t WHERE id IN (SELECT x FROM small s WHERE s.g = t.cat % 3) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----
physical_plan	<!REGEX>:.*PDXEARCH.*

# No late materialization (a second scan of t, joined on the rowid), next to the subquery's SEMI join.
query II
EXPLAIN SELECT id FROM t WHERE id IN (SELECT x FROM small) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----
physical_plan	<!REGEX>:.*rowid = rowid.*

query I rowsort in_subquery_k10
SELECT id FROM t WHERE id IN (SELECT x FROM small) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

endloop

# ============================================
# Compressed join keys in release builds too: DuckDB compresses the key of a subquery of at least 1,048,576 rows.
# t_big has more rows than big_ids, so the hash table is built on big_ids; only t's rows have an embedding.
# ============================================

statement ok
CREATE TABLE t_big AS SELECT range::BIGINT AS id, 'k' || range AS k, t.emb FROM range(1200000) LEFT JOIN t ON t.id = range;

statement ok
CREATE TABLE t_big_bf AS FROM t_big;

statement ok
CREATE TABLE big_ids AS SELECT (range + 16384)::BIGINT AS id, 'k' || (range + 16384) AS k FROM range(1100000);

statement ok
CREATE INDEX t_big_idx ON t_big USING PDXEARCH (emb) WITH (metric = 'l2sq', quantization = 'f32', n_probe = 0, seed = 0);

# The search reads the compressed integer key through its decompression.
query II
EXPLAIN SELECT id FROM t_big WHERE id IN (SELECT id FROM big_ids) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_FILT_SCAN.*__internal_decompress.*SEMI.*

query I rowsort compressed_integral_key
SELECT id FROM t_big WHERE id IN (SELECT id FROM big_ids) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query I rowsort compressed_integral_key
SELECT id FROM t_big_bf WHERE id IN (SELECT id FROM big_ids) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

# A short VARCHAR key is compressed too.
query II
EXPLAIN SELECT k FROM t_big WHERE k IN (SELECT k FROM big_ids) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_FILT_SCAN.*__internal_decompress.*SEMI.*

query I rowsort compressed_string_key
SELECT k FROM t_big WHERE k IN (SELECT k FROM big_ids) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query I rowsort compressed_string_key
SELECT k FROM t_big_bf WHERE k IN (SELECT k FROM big_ids) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

# A value computed from the decompressed key is not a table column: the search runs without the index.
query II
EXPLAIN SELECT x FROM (SELECT id * 2 AS x, emb FROM t_big WHERE id IN (SELECT id FROM big_ids)) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----
physical_plan	<!REGEX>:.*PDXEARCH.*

query I rowsort computed_from_compressed_key
SELECT x FROM (SELECT id * 2 AS x, emb FROM t_big WHERE id IN (SELECT id FROM big_ids)) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----

query I rowsort computed_from_compressed_key
SELECT x FROM (SELECT id * 2 AS x, emb FROM t_big_bf WHERE id IN (SELECT id FROM big_ids)) ORDER BY array_distance(emb, ${QUERY_EMB}::FLOAT[${DIMS}]) LIMIT 10;
----
