# name: test/sql/persistence/index_reconcile_concurrent_delete.test
# description: The first search after a reload reconciles the index while another connection commits a large DELETE: no deleted row is indexed again.
# group: [persistence]

require parquet

require duckir

load {TEST_DIR}/index_reconcile_concurrent_delete_main.db

statement ok
ATTACH '{TEST_DIR}/index_reconcile_concurrent_delete.db' AS w;

statement ok
SET checkpoint_threshold = '10GB';

statement ok
SET threads = 8;

# Variables
test-env DIMS 128

test-env QUERY_EMB [0,16,35,5,32,31,14,10,11,78,55,10,45,83,11,6,14,57,102,75,20,8,3,5,67,17,19,26,5,0,1,22,60,26,7,1,18,22,84,53,85,119,119,4,24,18,7,7,1,81,106,102,72,30,6,0,9,1,9,119,72,1,4,33,119,29,6,1,0,1,14,52,119,30,3,0,0,55,92,111,2,5,4,9,22,89,96,14,1,0,1,82,59,16,20,5,25,14,11,4,0,0,1,26,47,23,4,0,0,4,38,83,30,14,9,4,9,17,23,41,0,0,2,8,19,25,23,1]

statement ok
CREATE TABLE w.t AS SELECT id, emb::FLOAT[{DIMS}] AS emb FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet');

statement ok
CREATE INDEX t_idx ON w.t USING DUCKIR_VSS (emb) WITH (metric = 'l2sq', quantization = 'f32', n_probe = 0, seed = 0);

# The vectors of rows the DELETE below removes.
statement ok
CREATE TABLE w.dels AS SELECT * FROM w.t WHERE id % 100 = 0;

statement ok
CHECKPOINT w;

restart

statement ok
ATTACH '{TEST_DIR}/index_reconcile_concurrent_delete.db' AS w;

# Connection 1 starts its transaction first (a new one waits for the commit), then searches while the DELETE commits.
concurrentloop threadid 0 2

onlyif threadid=1
statement ok
BEGIN;

onlyif threadid=1
statement ok
SELECT id FROM w.dels LIMIT 1;

onlyif threadid=0
statement ok
BEGIN;

onlyif threadid=0
statement ok
DELETE FROM w.t WHERE id % 2 = 0;

onlyif threadid=0
statement ok
COMMIT;

sleep 85 milliseconds

onlyif threadid=1
statement ok
SELECT id FROM w.t ORDER BY array_distance(emb, {QUERY_EMB}::FLOAT[{DIMS}]) LIMIT 1;

onlyif threadid=1
statement ok
COMMIT;

endloop

query I
SELECT COUNT(*) FROM w.t;
----
122880

statement ok
CALL duckir_vss_sync_index('t_idx');

# Each deleted row's vector finds a live row: a deleted row still in the index would take the slot.
query I
SELECT (SELECT COUNT(*) FROM w.dels) - COUNT(*) FROM w.dels AS q, LATERAL (SELECT t2.id FROM w.t AS t2 ORDER BY array_distance(t2.emb, q.emb) LIMIT 1) r;
----
0
