# name: test/sql/out_of_core/index_sync_out_of_memory.test
# description: A sync that runs out of memory inside PDX leaves the index usable, and the next sync indexes the rows it could not; a DELETE commit at the memory limit succeeds and leaves the database usable.
# group: [out_of_core]

require parquet

require duckir

load {TEST_DIR}/index_sync_out_of_memory_main.db

statement ok
ATTACH '{TEST_DIR}/index_sync_out_of_memory.db' AS p;

statement ok
SET checkpoint_threshold = '10GB';

# Variables
test-env DIMS 128

# One partial row group of 100,000 rows, paged.
statement ok
CREATE TABLE p.t AS SELECT id, emb::FLOAT[{DIMS}] AS emb FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id < 100000;

statement ok
CREATE INDEX t_idx ON p.t USING DUCKIR_VSS (emb) WITH (quantization = 'f32');

statement ok
INSERT INTO p.t SELECT id, emb::FLOAT[{DIMS}] FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id >= 100000 AND id < 101500;

statement ok
SET VARIABLE query_emb = (SELECT emb FROM p.t WHERE id = 100000);

statement ok
SET memory_limit = '32MB';

# The search's sync loads the row group fully to append to it (about 66 MB).
statement error
SELECT id FROM p.t ORDER BY array_distance(emb, getvariable('query_emb')) LIMIT 10;
----
Out of Memory Error: failed to allocate data

statement ok
SET memory_limit = '1GB';

# The next sync appends them: each inserted row finds itself.
query I
SELECT count(*) FROM p.t q, LATERAL (SELECT array_distance(emb, q.emb) AS distance FROM p.t ORDER BY array_distance(emb, q.emb) LIMIT 1) s WHERE q.id >= 100000 AND s.distance = 0;
----
1500

# A DELETE commit on an unpaged index, with the memory limit just above the index: the deletes only tombstone, so the
# commit succeeds and the database stays usable. The merges they left pending run at the next checkpoint.
statement ok
DROP TABLE p.t;

statement ok
SET duckir_vss_cluster_paging = false;

statement ok
CREATE TABLE p.u AS SELECT id, emb::FLOAT[{DIMS}] AS emb FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id < 122880;

statement ok
CREATE INDEX u_idx ON p.u USING DUCKIR_VSS (emb) WITH (quantization = 'f32', n_probe = 0, seed = 0);

statement ok
CREATE TABLE p.u_bf AS FROM p.u WHERE id % 5 = 0;

statement ok
CHECKPOINT p;

statement ok
SET VARIABLE query_emb = (SELECT emb FROM p.u WHERE id = 5);

# The first sync after CREATE INDEX: the DELETE below then reaches the index at commit.
statement ok
SELECT id FROM p.u ORDER BY array_distance(emb, getvariable('query_emb')) LIMIT 3;

statement ok
BEGIN;

statement ok
DELETE FROM p.u WHERE id % 5 != 0;

# Measured in its own statement: DuckDB charges ALLOCATOR for its operators' buffers while a query runs.
statement ok
SET VARIABLE limit_bytes = (SELECT (sum(memory_usage_bytes) + 4 * 1024 * 1024)::VARCHAR || 'B' FROM duckdb_memory() WHERE tag IN ('ALLOCATOR', 'EXTENSION'));

statement ok
SET memory_limit = getvariable('limit_bytes');

statement ok
COMMIT;

statement ok
SELECT 1;

statement ok
SET memory_limit = '1GB';

query I nosort deleted
SELECT id FROM p.u_bf ORDER BY array_distance(emb, getvariable('query_emb')), id LIMIT 10;
----

query I nosort deleted
SELECT id FROM p.u ORDER BY array_distance(emb, getvariable('query_emb')) LIMIT 10;
----

statement ok
CHECKPOINT p;

query I nosort merged
SELECT id FROM p.u_bf ORDER BY array_distance(emb, getvariable('query_emb')), id LIMIT 10;
----

query I nosort merged
SELECT id FROM p.u ORDER BY array_distance(emb, getvariable('query_emb')) LIMIT 10;
----
