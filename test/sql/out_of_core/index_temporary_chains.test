# name: test/sql/out_of_core/index_temporary_chains.test
# description: Before a checkpoint, a paged index lives in temporary chains: it builds and searches under a memory_limit below its size, and gives the results of the fully loaded index once persisted.
# group: [out_of_core]

require parquet

require pdxearch

load __TEST_DIR__/index_temporary_chains_main.db

statement ok
ATTACH '__TEST_DIR__/index_temporary_chains.db' AS p (ROW_GROUP_SIZE 8192);

statement ok
SET checkpoint_threshold = '10GB';

# Variables
test-env DIMS 128

# Two full row groups and a partial one (IVF, 5,616 rows).
statement ok
CREATE TABLE p.t AS SELECT id, emb::FLOAT[${DIMS}] AS emb FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id < 22000;

statement ok
CREATE TABLE p.q AS SELECT id AS qid, emb::FLOAT[${DIMS}] AS vec FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id >= 200000 AND id < 200020;

statement ok
SET threads = 2;

statement ok
SET memory_limit = '32MB';

statement ok
SET pdxearch_cluster_paging = false;

# Without paging, the index stays on the heap: it does not fit (about 47 MB).
statement error
CREATE INDEX t_idx ON p.t USING PDXEARCH (emb) WITH (quantization = 'f32');
----
Out of Memory Error

statement ok
SET pdxearch_cluster_paging = true;

statement ok
CREATE INDEX t_idx ON p.t USING PDXEARCH (emb) WITH (quantization = 'f32');

# An insert into the partial row group, which the next search loads fully and moves to a new temporary chain.
statement ok
INSERT INTO p.t SELECT id, emb::FLOAT[${DIMS}] FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id >= 22000 AND id < 23500;

query II nosort homed
SELECT q.qid, s.id FROM p.q q, LATERAL (SELECT id FROM p.t ORDER BY array_distance(emb, q.vec) LIMIT 10) s ORDER BY ALL;
----

statement ok
CHECKPOINT p;

statement ok
SET memory_limit = '1GB';

statement ok
SET pdxearch_cluster_paging = false;

restart

statement ok
ATTACH '__TEST_DIR__/index_temporary_chains.db' AS p (ROW_GROUP_SIZE 8192);

# Loaded fully from the chains the checkpoint copied, the index gives the same results.
query II nosort homed
SELECT q.qid, s.id FROM p.q q, LATERAL (SELECT id FROM p.t ORDER BY array_distance(emb, q.vec) LIMIT 10) s ORDER BY ALL;
----
