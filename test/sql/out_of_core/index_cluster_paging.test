# name: test/sql/out_of_core/index_cluster_paging.test
# description: A paged index gives the results of the fully loaded one, also after writes, and searches under a memory_limit below its size.
# group: [out_of_core]

require parquet

require pdxearch

load __TEST_DIR__/index_cluster_paging_main.db

statement ok
ATTACH '__TEST_DIR__/index_cluster_paging.db' AS p (ROW_GROUP_SIZE 8192);

statement ok
SET checkpoint_threshold = '10GB';

# Variables
test-env DIMS 128

# Two full row groups and a partial one (IVF, 5,616 rows).
statement ok
CREATE TABLE p.t AS SELECT id, emb::FLOAT[${DIMS}] AS emb FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id < 22000;

statement ok
CREATE TABLE p.q AS SELECT id AS qid, emb::FLOAT[${DIMS}] AS vec FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id >= 200000 AND id < 200020;

statement ok
CREATE INDEX t_idx ON p.t USING PDXEARCH (emb) WITH (quantization = 'f32');

statement ok
CHECKPOINT p;

statement ok
SET pdxearch_cluster_paging = false;

restart

statement ok
ATTACH '__TEST_DIR__/index_cluster_paging.db' AS p (ROW_GROUP_SIZE 8192);

statement ok
SET checkpoint_threshold = '10GB';

query II nosort loaded
SELECT q.qid, s.id FROM p.q q, LATERAL (SELECT id FROM p.t ORDER BY array_distance(emb, q.vec) LIMIT 10) s ORDER BY ALL;
----

statement ok
SET pdxearch_cluster_paging = true;

restart

statement ok
ATTACH '__TEST_DIR__/index_cluster_paging.db' AS p (ROW_GROUP_SIZE 8192);

# Paged, the index gives the same results.
query II nosort loaded
SELECT q.qid, s.id FROM p.q q, LATERAL (SELECT id FROM p.t ORDER BY array_distance(emb, q.vec) LIMIT 10) s ORDER BY ALL;
----

# Writes to the paged index: deletes, and inserts into its partial row group.
statement ok
DELETE FROM p.t WHERE id % 7 = 0;

statement ok
INSERT INTO p.t SELECT id, emb::FLOAT[${DIMS}] FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id >= 22000 AND id < 23500;

statement ok
SELECT q.qid, s.id FROM p.q q, LATERAL (SELECT id FROM p.t ORDER BY array_distance(emb, q.vec) LIMIT 10) s;

statement ok
CHECKPOINT p;

statement ok
SET threads = 2;

statement ok
SET memory_limit = '32MB';

statement ok
SET pdxearch_paging_counters = true;

restart

statement ok
ATTACH '__TEST_DIR__/index_cluster_paging.db' AS p (ROW_GROUP_SIZE 8192);

# Paged, it searches under a limit below its full size (about 47 MB).
query II nosort written
SELECT q.qid, s.id FROM p.q q, LATERAL (SELECT id FROM p.t ORDER BY array_distance(emb, q.vec) LIMIT 10) s ORDER BY ALL;
----

query I
SELECT cluster_cache_misses > 0 FROM pdxearch_index_info() WHERE index_name = 't_idx';
----
true

statement ok
SET pdxearch_cluster_paging = false;

restart

statement ok
ATTACH '__TEST_DIR__/index_cluster_paging.db' AS p (ROW_GROUP_SIZE 8192);

# Loaded fully, it does not fit.
statement error
SELECT q.qid, s.id FROM p.q q, LATERAL (SELECT id FROM p.t ORDER BY array_distance(emb, q.vec) LIMIT 10) s ORDER BY ALL;
----
Out of Memory Error

statement ok
SET memory_limit = '1GB';

restart

statement ok
ATTACH '__TEST_DIR__/index_cluster_paging.db' AS p (ROW_GROUP_SIZE 8192);

# Loaded fully, the written index gives the same results.
query II nosort written
SELECT q.qid, s.id FROM p.q q, LATERAL (SELECT id FROM p.t ORDER BY array_distance(emb, q.vec) LIMIT 10) s ORDER BY ALL;
----
