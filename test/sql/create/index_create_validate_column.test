# name: test/sql/create/index_create_validate_column.test
# description: Validate the column the index is created over.
# group: [create]

require duckir

# ============================================
# Invalid create index statement
# ============================================

statement ok
CREATE OR REPLACE TABLE t1 (id INTEGER, emb FLOAT[128]);

statement error
CREATE INDEX t1_idx ON t1 USING DUCKIR_VSS (emb, id);
----
Binder Error: DuckIR VSS indexes can only be created over a single column of keys.

# ============================================
# Invalid table column type
# ============================================

statement ok
CREATE OR REPLACE TABLE t1 (id INTEGER, emb FLOAT);

statement error
CREATE INDEX t1_idx ON t1 USING DUCKIR_VSS (emb);
----
Binder Error: DuckIR VSS index keys must be of type FLOAT[N]

statement ok
CREATE OR REPLACE TABLE t1 (id INTEGER, emb DOUBLE[128]);

statement error
CREATE INDEX t1_idx ON t1 USING DUCKIR_VSS (emb);
----
Binder Error: DuckIR VSS index key type must be FLOAT

# ============================================
# Valid number of dimensions
# ============================================

statement ok
CREATE OR REPLACE TABLE t1 (id INTEGER, emb FLOAT[128]);

statement ok
INSERT INTO t1 SELECT i + 1 as id, list_transform(range(128), lambda x: random()) FROM range(10000) t(i);

statement ok
CREATE INDEX t1_idx ON t1 USING DUCKIR_VSS (emb);

# ============================================
# Invalid number of dimensions
# ============================================

# The dimensions are checked on the column type, so the table stays empty.
foreach dims 16385 70000

statement ok
CREATE OR REPLACE TABLE t1 (id INTEGER, emb FLOAT[${dims}]);

statement error
CREATE INDEX t1_idx ON t1 USING DUCKIR_VSS (emb);
----
<REGEX>:Binder Error: DuckIR VSS index FLOAT array length \(i\.e\., dimensions\) must be less than or equal to 16384, got .*

endloop
