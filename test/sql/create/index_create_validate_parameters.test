# name: test/sql/create/index_create_validate_parameters.test
# description: Validate the parameters passed during index creation.
# group: [create]

require parquet

require duckir

statement ok
CREATE TABLE t1 (id INTEGER, emb FLOAT[128]);

statement ok
INSERT INTO t1 FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') LIMIT 10000;

# ============================================
# Combination of parameters
# ============================================

statement ok
CREATE INDEX idx ON t1 USING DUCKIR_VSS (emb) WITH (metric = 'l2sq', quantization = 'f32', n_probe = 128, seed = 0);

statement ok
DROP INDEX IF EXISTS idx;

# ============================================
# Parameter: metric
# ============================================

statement error
CREATE INDEX idx ON t1 USING DUCKIR_VSS (emb) WITH (metric = 1);
----
Binder Error: DuckIR VSS index 'metric' must be a string

statement error
CREATE INDEX idx ON t1 USING DUCKIR_VSS (emb) WITH (metric = 'test');
----
Binder Error: DuckIR VSS index 'metric' must be one of: 'cosine', 'l2sq'

foreach metric l2sq

statement ok
CREATE INDEX idx ON t1 USING DUCKIR_VSS (emb) WITH (metric = '${metric}');

statement ok
DROP INDEX IF EXISTS idx;

endloop

# ============================================
# Parameter: quantization
# ============================================

statement error
CREATE INDEX idx ON t1 USING DUCKIR_VSS (emb) WITH (quantization = 1);
----
Binder Error: DuckIR VSS index 'quantization' must be a string

statement error
CREATE INDEX idx ON t1 USING DUCKIR_VSS (emb) WITH (quantization = 'test');
----
Binder Error: DuckIR VSS index 'quantization' must be one of: 'f32', 'u8'

foreach quantization f32 u8

statement ok
CREATE INDEX idx ON t1 USING DUCKIR_VSS (emb) WITH (quantization = '${quantization}');

statement ok
DROP INDEX IF EXISTS idx;

endloop

# ============================================
# Parameter: n_probe
# ============================================

statement error
CREATE INDEX idx ON t1 USING DUCKIR_VSS (emb) WITH (n_probe = 'test');
----
Binder Error: DuckIR VSS index 'n_probe' must be an integer

foreach invalid_n_probe -1 -100

statement error
CREATE INDEX idx ON t1 USING DUCKIR_VSS (emb) WITH (n_probe = ${invalid_n_probe});
----
<REGEX>:Binder Error: DuckIR VSS index 'n_probe' must be at least 0, default is .*

endloop

foreach valid_n_probe 0 1 10000

statement ok
CREATE INDEX idx ON t1 USING DUCKIR_VSS (emb) WITH (n_probe = ${valid_n_probe});

statement ok
DROP INDEX IF EXISTS idx;

endloop

# ============================================
# Parameter: seed
# ============================================

# int32 ranges from -2147483648 to 2147483647.

foreach invalid_seed 'test' -2147483649 2147483648

statement error
CREATE INDEX idx ON t1 USING DUCKIR_VSS (emb) WITH (seed = ${invalid_seed});
----
Binder Error: DuckIR VSS index 'seed' must be between -2147483648 and 2147483647, inclusive

endloop

foreach valid_seed -2147483648 -2147483647 -1 0 1 2147483647

statement ok
CREATE INDEX idx ON t1 USING DUCKIR_VSS (emb) WITH (seed = ${valid_seed});

statement ok
DROP INDEX IF EXISTS idx;

endloop
