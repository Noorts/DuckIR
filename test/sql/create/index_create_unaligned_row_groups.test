# name: test/sql/create/index_create_unaligned_row_groups.test
# description: The index mirrors the table's physical row groups, which are not always full and aligned: a bulk insert onto a half-full row group leaves it half full (4096/4096/8192/8192/8192).
# group: [create]

require parquet

require pdxearch

# A database with small row groups keeps the multi-row-group layouts cheap; no automatic checkpoint may merge
# row groups halfway through the test.
statement ok
ATTACH '__TEST_DIR__/una.db' AS una (ROW_GROUP_SIZE 8192);

statement ok
USE una;

statement ok
SET checkpoint_threshold = '10GB';

# Variables
test-env DIMS 128

test-env LIMIT 10

test-env QUERY_EMB_A [0,16,35,5,32,31,14,10,11,78,55,10,45,83,11,6,14,57,102,75,20,8,3,5,67,17,19,26,5,0,1,22,60,26,7,1,18,22,84,53,85,119,119,4,24,18,7,7,1,81,106,102,72,30,6,0,9,1,9,119,72,1,4,33,119,29,6,1,0,1,14,52,119,30,3,0,0,55,92,111,2,5,4,9,22,89,96,14,1,0,1,82,59,16,20,5,25,14,11,4,0,0,1,26,47,23,4,0,0,4,38,83,30,14,9,4,9,17,23,41,0,0,2,8,19,25,23,1]

test-env QUERY_EMB_B [1,3,11,110,62,22,4,0,43,21,22,18,6,28,64,9,11,1,0,0,1,40,101,21,20,2,4,2,2,9,18,35,1,1,7,25,108,116,63,2,0,0,11,74,40,101,116,3,33,1,1,11,14,18,116,116,68,12,5,4,2,2,9,102,17,3,10,18,8,15,67,63,15,0,14,116,80,0,2,22,96,37,28,88,43,1,4,18,116,51,5,11,32,14,8,23,44,17,12,9,0,0,19,37,85,18,16,104,22,6,2,26,12,58,67,82,25,12,2,2,25,18,8,2,19,42,48,11]

statement ok
CREATE TABLE sift AS SELECT id, emb::FLOAT[${DIMS}] AS emb FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') WHERE id < 32768;

statement ok
CREATE TABLE t1 AS SELECT * FROM sift WHERE id < 4096;

statement ok
INSERT INTO t1 SELECT * FROM sift WHERE id >= 4096;

query II
SELECT row_group_id, sum(count) FROM pragma_storage_info('t1') WHERE column_name = 'id' AND segment_type <> 'VALIDITY' GROUP BY 1 ORDER BY 1;
----
0	4096
1	4096
2	8192
3	8192
4	8192

# Copy of the table without an index for verification.
statement ok
CREATE TABLE t_no_index AS FROM t1;

foreach quantization f32

statement ok
DROP INDEX IF EXISTS t1_idx;

statement ok
CREATE INDEX t1_idx ON t1 USING PDXEARCH (emb) WITH (metric = 'l2sq', quantization = '${quantization}', n_probe = 0, seed = 0);

query II
EXPLAIN SELECT * FROM t1 ORDER BY array_distance(emb, ${QUERY_EMB_A}::FLOAT[${DIMS}]) LIMIT ${LIMIT};
----
physical_plan	<REGEX>:.*PDXEARCH_INDEX_SCAN.*Total Clusters: 600[^0-9].*Row Groups: 5[^0-9].*

statement ok
CREATE OR REPLACE TABLE t_gt AS SELECT id FROM t_no_index WHERE emb IS NOT NULL ORDER BY array_distance(emb, ${QUERY_EMB_A}::FLOAT[${DIMS}]) LIMIT ${LIMIT};

statement ok
CREATE OR REPLACE TABLE t_idx_res AS SELECT id FROM t1 ORDER BY array_distance(emb, ${QUERY_EMB_A}::FLOAT[${DIMS}]) LIMIT ${LIMIT};

query I
SELECT COUNT(*) >= ${LIMIT} - 1 FROM t_gt JOIN t_idx_res USING (id);
----
true

statement ok
CREATE OR REPLACE TABLE t_gt AS SELECT id FROM t_no_index WHERE emb IS NOT NULL ORDER BY array_distance(emb, ${QUERY_EMB_B}::FLOAT[${DIMS}]) LIMIT ${LIMIT};

statement ok
CREATE OR REPLACE TABLE t_idx_res AS SELECT id FROM t1 ORDER BY array_distance(emb, ${QUERY_EMB_B}::FLOAT[${DIMS}]) LIMIT ${LIMIT};

query I
SELECT COUNT(*) >= ${LIMIT} - 1 FROM t_gt JOIN t_idx_res USING (id);
----
true

# Filtered search over the same rows.
statement ok
CREATE OR REPLACE TABLE t_gt AS SELECT id FROM t_no_index WHERE emb IS NOT NULL AND id % 3 = 0 ORDER BY array_distance(emb, ${QUERY_EMB_A}::FLOAT[${DIMS}]) LIMIT ${LIMIT};

statement ok
CREATE OR REPLACE TABLE t_idx_res AS SELECT id FROM t1 WHERE id % 3 = 0 ORDER BY array_distance(emb, ${QUERY_EMB_A}::FLOAT[${DIMS}]) LIMIT ${LIMIT};

query I
SELECT COUNT(*) >= ${LIMIT} - 1 FROM t_gt JOIN t_idx_res USING (id);
----
true

endloop
