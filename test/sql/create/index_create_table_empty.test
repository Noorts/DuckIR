# name: test/sql/create/index_create_table_empty.test
# description: Index creation behavior on empty and on non-empty tables.
# group: [create]

require parquet

require duckir

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

test-env QUERY_EMB [0,16,35,5,32,31,14,10,11,78,55,10,45,83,11,6,14,57,102,75,20,8,3,5,67,17,19,26,5,0,1,22,60,26,7,1,18,22,84,53,85,119,119,4,24,18,7,7,1,81,106,102,72,30,6,0,9,1,9,119,72,1,4,33,119,29,6,1,0,1,14,52,119,30,3,0,0,55,92,111,2,5,4,9,22,89,96,14,1,0,1,82,59,16,20,5,25,14,11,4,0,0,1,26,47,23,4,0,0,4,38,83,30,14,9,4,9,17,23,41,0,0,2,8,19,25,23,1]

# ============================================
# Empty table: inserted rows are indexed by the next search.
# ============================================
statement ok
CREATE OR REPLACE TABLE t1 (id INTEGER, emb FLOAT[128]);

statement ok
CREATE INDEX t1_idx ON t1 USING DUCKIR_VSS (emb);

query II
EXPLAIN SELECT id FROM t1 ORDER BY array_distance(emb, {QUERY_EMB}::FLOAT[128]) LIMIT 10;
----
physical_plan	<REGEX>:.*DUCKIR_VSS_INDEX_SCAN.*

query I
SELECT id FROM t1 ORDER BY array_distance(emb, {QUERY_EMB}::FLOAT[128]) LIMIT 10;
----

statement ok
INSERT INTO t1 FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') LIMIT 10000;

query I
SELECT count(*) FROM (SELECT id FROM t1 ORDER BY array_distance(emb, {QUERY_EMB}::FLOAT[128]) LIMIT 10);
----
10

# ============================================
# Non-empty table
# ============================================
statement ok
CREATE OR REPLACE TABLE t1 (id INTEGER, emb FLOAT[128]);

statement ok
INSERT INTO t1 FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') LIMIT 10000;

statement ok
CREATE INDEX t1_idx ON t1 USING DUCKIR_VSS (emb);
