# name: test/sql/search/index_scan_blob_query.test
# description: Test blob-based query vectors for DuckIR VSS index scan
# group: [search]

require parquet

require duckir

statement ok
SET profiling_renderer_settings = MAP {'operator_casing': 'upper'};

# ============================================
# 1. Encoding: the float32 values of the text, as little-endian bytes
# ============================================

query I
SELECT duckir_vss_encode_query('[1.0, -0.5, 0.001, 0.0, -0.001]') = from_hex('0000803f000000bf6f12833a000000006f1283ba');
----
true

# Values beyond the old 16-bit encoding's range stay exact.
query I
SELECT duckir_vss_encode_query('[184.95, 982.2845]') = from_hex('33f3384335927544');
----
true

# ============================================
# 2. NULLs and malformed text
# ============================================

query I
SELECT duckir_vss_encode_query(NULL) IS NULL;
----
true

statement error
SELECT duckir_vss_encode_query('[1.0, NULL]');
----
the query vector can not contain NULL values

statement error
SELECT duckir_vss_encode_query('[1.0, abc]');
----
Could not convert string 'abc' to FLOAT

# ============================================
# 3. Distances equal those of the FLOAT[d] query, in both argument orders
# ============================================

statement ok
CREATE TABLE t1 (id INTEGER, emb FLOAT[3]);

statement ok
INSERT INTO t1 VALUES (1, [1.0, 0.0, 0.0]), (2, [0.0, 1.0, 0.0]), (3, [0.25, -0.5, 2.0]);

query I
SELECT bool_and(
    array_distance(duckir_vss_encode_query('[1.0, 0.5, -2.0]'), emb) = array_distance('[1.0, 0.5, -2.0]'::FLOAT[3], emb)
    AND array_distance(emb, duckir_vss_encode_query('[1.0, 0.5, -2.0]')) = array_distance(emb, '[1.0, 0.5, -2.0]'::FLOAT[3])
    AND array_distance(emb, duckir_vss_encode_query('[1.0, 0.5, -2.0]')) = array_distance(emb, [1.0, 0.5, -2.0]::FLOAT[3])
    AND array_cosine_distance(duckir_vss_encode_query('[1.0, 0.5, -2.0]'), emb) = array_cosine_distance('[1.0, 0.5, -2.0]'::FLOAT[3], emb)
    AND array_cosine_distance(emb, duckir_vss_encode_query('[1.0, 0.5, -2.0]')) = array_cosine_distance(emb, '[1.0, 0.5, -2.0]'::FLOAT[3])
    AND (duckir_vss_encode_query('[1.0, 0.5, -2.0]') <-> emb) = ('[1.0, 0.5, -2.0]'::FLOAT[3] <-> emb)
    AND (emb <=> duckir_vss_encode_query('[1.0, 0.5, -2.0]')) = (emb <=> '[1.0, 0.5, -2.0]'::FLOAT[3]))
FROM t1;
----
true

# Cosine on degenerate vectors as DuckDB: NaN for a zero vector, 0 for identical vectors whose norms underflow or overflow.
query III
SELECT isnan(array_cosine_distance(emb, duckir_vss_encode_query('[0.0, 0.0, 0.0]'))),
       array_cosine_distance('[1e-30, 1e-30, 1e-30]'::FLOAT[3], duckir_vss_encode_query('[1e-30, 1e-30, 1e-30]')),
       array_cosine_distance('[1e20, 1e20, 1e20]'::FLOAT[3], duckir_vss_encode_query('[1e20, 1e20, 1e20]'))
FROM t1 WHERE id = 1;
----
true	0.0	0.0

statement error
SELECT array_distance(emb, duckir_vss_encode_query('[1.0, 0.0]')) FROM t1;
----
BLOB of 8 bytes does not hold the 3 float32 values of the array

statement ok
DROP TABLE t1;

# ============================================
# 4. Optimizer recognition: EXPLAIN shows DUCKIR_VSS_INDEX_SCAN with blob query
# ============================================

test-env DIMS 128

test-env NUM_ROWS 20000

test-env QUERY_EMB [0,16,35,5,32,31,14,10,11,78,55,10,45,83,11,6,14,57,102,75,20,8,3,5,67,17,19,26,5,0,1,22,60,26,7,1,18,22,84,53,85,119,119,4,24,18,7,7,1,81,106,102,72,30,6,0,9,1,9,119,72,1,4,33,119,29,6,1,0,1,14,52,119,30,3,0,0,55,92,111,2,5,4,9,22,89,96,14,1,0,1,82,59,16,20,5,25,14,11,4,0,0,1,26,47,23,4,0,0,4,38,83,30,14,9,4,9,17,23,41,0,0,2,8,19,25,23,1]

statement ok
CREATE TABLE t2 (id INTEGER, emb FLOAT[{DIMS}]);

statement ok
INSERT INTO t2 FROM read_parquet('test/assets/sift-128-euclidean-245760.parquet') LIMIT {NUM_ROWS};

foreach metric_name,distance_func l2sq,array_distance cosine,array_cosine_distance

statement ok
DROP INDEX IF EXISTS t2_idx;

statement ok
CREATE INDEX t2_idx ON t2 USING DUCKIR_VSS (emb) WITH (metric = '{metric_name}');

# Index scan is used with blob query
query II
EXPLAIN SELECT * FROM t2 ORDER BY {distance_func}(emb, duckir_vss_encode_query('{QUERY_EMB}')) LIMIT 10;
----
physical_plan	<REGEX>:.*DUCKIR_VSS_INDEX_SCAN.*

# The same nearest rows as the FLOAT[d] query.
query I
SELECT count(*) FROM (
    (SELECT id FROM t2 ORDER BY {distance_func}(emb, duckir_vss_encode_query('{QUERY_EMB}')) LIMIT 10)
    EXCEPT
    (SELECT id FROM t2 ORDER BY {distance_func}(emb, {QUERY_EMB}::FLOAT[{DIMS}]) LIMIT 10));
----
0

endloop

# ============================================
# 5. Operator aliases work with blob
# ============================================

statement ok
DROP INDEX IF EXISTS t2_idx;

statement ok
CREATE INDEX t2_idx ON t2 USING DUCKIR_VSS (emb) WITH (metric = 'l2sq');

query II
EXPLAIN SELECT * FROM t2 ORDER BY emb <-> duckir_vss_encode_query('{QUERY_EMB}') LIMIT 10;
----
physical_plan	<REGEX>:.*DUCKIR_VSS_INDEX_SCAN.*

statement ok
DROP INDEX IF EXISTS t2_idx;

statement ok
CREATE INDEX t2_idx ON t2 USING DUCKIR_VSS (emb) WITH (metric = 'cosine');

query II
EXPLAIN SELECT * FROM t2 ORDER BY emb <=> duckir_vss_encode_query('{QUERY_EMB}') LIMIT 10;
----
physical_plan	<REGEX>:.*DUCKIR_VSS_INDEX_SCAN.*

statement ok
DROP TABLE t2;
